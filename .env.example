# Compose namespace; never point this package at a production project.
COMPOSE_PROJECT_NAME=relay
APP_URL=http://localhost:3100
APP_PORT=3100
# Fixed application DB/role names are part of immutable migration contracts.
POSTGRES_DB=ticket_system
POSTGRES_USER=relay_bootstrap
POSTGRES_PASSWORD=
TICKET_RUNTIME_PASSWORD=
RELAY_READER_PASSWORD=
SERVICE_DESK_DATABASE_URL=
SERVICE_DESK_AUTH_USER=
SERVICE_DESK_AUTH_PASSWORD=
# Optional desktop observer only; never used by Compose's pg transport.
SERVICE_DESK_LOCAL_CONTAINER=
SERVICE_DESK_LOCAL_DB_USER=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
N8N_DRY_RUN=true
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678
N8N_REQUEST_TIMEOUT_MS=15000
# These are operator setup inputs; secrets go in n8n credentials, not TI-00.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OPERATOR_USER_ID=
TELEGRAM_OPERATOR_CHAT_ID=
GROQ_API_KEY=
# Database policy: setup checks these, bootstrap applies them to a fresh DB only.
AUDIO_RETENTION_HOURS=72
INTERACTION_EXPIRY_HOURS=48
